E 2.0 Act): born 1950 or earlier: 72 (70 1/2 if born before July 1, 1949);\n  // born 1951-1959: 73; born 1960 or later: 75.\n  var EXCISE_RATE = 0.25, EXCISE_CORRECTED = 0.10;\n  // ------------------------------------------------------------------------------------------------\n  var ROWS = 5;\n  var TYPE_NAMES = { ira: 'IRA', '403b': '403(b)', '401k': '401(k)', '457b': '457(b)', plan: 'Employer plan' };\n\n  var jointCache = {};\n  function jointFactor(ownerAge, spouseAge) {\n    var o = Math.min(ownerAge, 120);\n    if (!jointCache[o]) {\n      var raw = JOINT_TABLE_RAW[o];\n      if (!raw) return null;\n      jointCache[o] = raw.split(',').map(function (x) { return parseInt(x, 10) / 10; });\n    }\n    var v = jointCache[o][spouseAge - 20];\n    return v === undefined ? null : v;\n  }\n  function uniformFactor(age) { return UNIFORM_TABLE[Math.min(age, 120)] || null; }\n  function startAge(birthYear) {\n    if (birthYear <= 1950) return 72;\n    if (birthYear <= 1959) return 73;\n    return 75;\n  }\n  // Returns { factor, joint } for the owner (and spouse age, or null).\n  function divisorFor(age, spouseAge) {\n    if (spouseAge !== null && age - spouseAge > 10 && spouseAge >= 20) {\n      var j = jointFactor(age, spouseAge);\n      if (j) return { factor: j, joint: true };\n    }\n    return { factor: uniformFactor(age), joint: false };\n  }\n\n  // p: { birth, year, spouseBirth|null, accounts: [{ n, type, balance, taken, work }] }\n  // work: 'none' | 'retired' (left this employer during the RMD year) | 'working' (all year).\n  function compute(p) {\n    var age = p.year - p.birth, sa = startAge(p.birth), first = p.birth + sa;\n    var spouseAge = p.spouseBirth === null ? null : p.year - p.spouseBirth;\n    var due = age >= sa;\n    var d = due ? divisorFor(age, spouseAge) : null;\n    var groups = [], byKey = {}, accounts = [];\n    p.accounts.forEach(function (a) {\n      if (!(a.balance > 0) && !(a.taken > 0)) return;\n      var plan = a.type !== 'ira';\n 
; }\n  function num(id) {\n    var raw = el(id).value;\n    if (raw === '' || raw === null || raw === undefined) return NaN;\n    var v = parseFloat(raw);\n    return isNaN(v) ? NaN : v;\n  }\n  function amount(id) { var raw = el(id).value; if (raw === '' || raw === null || raw === undefined) return 0; return num(id); }\n  function set(id, text) { el(id).textContent = text; }\n  function fillRows(id, rows) {\n    var body = el(id);\n    body.textContent = '';\n    rows.forEach(function (cells) {\n      var tr = document.createElement('tr');\n      cells.forEach(function (v) { var td = document.createElement('td'); td.textContent = v; tr.appendChild(td); });\n      body.appendChild(tr);\n    });\n  }\n  function clear() {\n    ['rcTotal', 'rcRemaining', 'rcDeadline', 'rcAge', 'rcDivisor', 'rcFirst', 'rcShortfall', 'rcPenalty25', 'rcPenalty10']\n      .forEach(function (id) { set(id, '–'); });\n    set('rcNote', '');\n    fillRows('rcGroups', []);\n    fillRows('rcAccounts', []);\n  }\n\n  function update() {\n    var spouseOn = el('rcSpouse').checked;\n    el('rcSpouseField').classList.toggle('form-field-hidden', !spouseOn);\n    var accounts = [], badAmount = false;\n    for (var i = 1; i <= ROWS; i++) {\n      var type = el('rcType' + i).value, work = el('rcWork' + i);\n      work.disabled = type === 'ira';\n      var bal = amount('rcBal' + i), taken = amount('rcTaken' + i);\n      if (isNaN(bal) || isNaN(taken) || bal < 0 || taken < 0) badAmount = true;\n      accounts.push({ n: i, type: type, balance: bal, taken: taken, work: type === 'ira' ? 'none' : work.value });\n    }\n    var birth = Math.round(num('rcBirth')), year = Math.round(num('rcYear'));\n    var spouseBirth = spouseOn ? Math.round(num('rcSpouseBirth')) : null;\n    var error = el('rcError'), msg = '';\n    if (isNaN(birth) || isNaN(year) || birth < 1920 || birth > 2010 || year < 2024 || year > 2040) {\n      msg = 'Enter a birth year from 1920 to 2010 and an RMD year from 2024 to 2040.';\n    } else if (year - birth > 120 || year - birth < 0) {\n      msg = 'Your age at the end of the RMD year must be from 0 to 120.';\n    } else if (spouseOn && (isNaN(spouseBirth) || spouseBirth < 1920 || spouseBirth > year)) {\n      msg = 'Enter your spouse’s year of birth (1920 or later, not after the RMD year).';\n    } else if (spouseOn && year - spouseBirth < 20 && year - birth - (year - spouseBirth) > 10) {\n      msg = 'The IRS joint life table starts at age 20. Enter a spouse who is at least 20 in the RMD year.';\n    } else if (badAmount) {\n      msg = 'Balances and withdrawals must be 0 or more.';\n    }\n    error.hidden = !msg;\n    if (msg) { error.textContent = msg; clear(); return; }\n\n    var r = compute({ birth: birth, year: year, spouseBirth: spouseBirth, accounts: accounts });\n    set('rcTotalLabel', 'Total RMD for ' + year);\n    set('rcTotal', money(r.total));\n    set('rcRemaining', money(r.remaining));\n    set('rcAge', String(r.age));\n    set('rcFirst', birth <= 1949 ? 'Age 70½' : r.first + ' (' + r.startAge + ')');\n    if (r.due) {\n      set('rcDivisorLabel', r.divisor.joint ? 'Joint life factor (Table II)' : 'Uniform Lifetime factor');\n      set('rcDivisor', r.divisor.factor.toFixed(1));\n    } else {\n      set('rcDivisorLabel', 'Distribution period');\n      set('rcDivisor', 'None yet');\n    }\n    set('rcDeadline', r.total <= 0 ? 'None' : r.anyFirst && !r.anyDec ? 'April 1, ' + (year + 1)\n      : r.anyFirst ? 'Dec 31 / Apr 1' : 'December 31, ' + year);\n\n    var notes = [];\n    if (!r.due) {\n      notes.push('No RMD is due for ' + year + '. Your first RMD is for ' + r.first + ', the year you turn ' + r.startAge +\n                 ', and it can wait until April 1, ' + (r.first + 1) + '.');\n    } else {\n      if (year === r.first) {\n        notes.push('This is your first RMD year. You can take it by December 31, ' + year + ' or wait until April 1, ' + (year + 1) +\n                   '. If you wait, you also owe your ' + (year + 1) + ' RMD by December 31, ' + (year + 1) +\n                   ', so two RMDs are taxed in the same year.');\n      } else if (year === r.first + 1) {\n        notes.push('If you delayed last year’s first RMD, it is due by April 1, ' + year + ' and does not count toward the ' + year + ' RMD shown here.');\n      }\n      if (r.accounts.some(function (a) { return a.type !== 'ira' && a.firstYear && year !== r.first; })) {\n        notes.push('For a plan you left in ' + year + ', this is that plan’s first RMD, so it can wait until April 1, ' + (year + 1) + '.');\n      }\n      if (spouseOn && r.spouseAge !== null && !r.divisor.joint) {\n        notes.push('Your spouse is not more than 10 years younger than you, so the Uniform Lifetime Table applies.');\n      }\n      if (r.divisor.joint) {\n        notes.push('Because your spouse (age ' + r.spouseAge + ') is your sole beneficiary and more than 10 years younger, the RMD uses the Joint and Last Survivor table instead of the Uniform Lifetime factor of ' +\n                   uniformFactor(r.age).toFixed(1) + '.');\n      }\n    }\n    set('rcNote', notes.join(' '));\n\n    fillRows('rcGroups', r.groups.map(function (g) {\n      var label;\n      if (g.pooled) {\n        label = (g.type === 'ira' ? 'IRAs' : '403(b)s') + ' (accounts ' + g.accounts.join(', ') + ')';\n        if (g.accounts.length === 1) label = TYPE_NAMES[g.type] + ' (account ' + g.accounts[0] + ')';\n      } else {\n        label = TYPE_NAMES[g.type] + ' (account ' + g.accounts[0] + ')';\n      }\n      var from = g.pooled ? (g.type === 'ira' ? 'Any one or more of your IRAs' : 'Any one or more of your 403(b)s') : 'This plan only';\n      var deadline = !g.due ? '–' : g.firstYear ? 'April 1, ' + (year + 1) : 'December 31, ' + year;\n      return [label, money(g.rmd), money(g.taken), money(g.remaining), from, deadline];\n    }));\n    fillRows('rcAccounts', r.accounts.map(function (a) {\n      return ['Account ' + a.n, TYPE_NAMES[a.type], money(a.balance), a.factor ? a.factor.toFixed(1) : '–', money(a.rmd), a.status];\n    }));\n    set('rcShortfall', money(r.remaining));\n    set('rcPenalty25', money(r.penalty25));\n    set('rcPenalty10', money(r.penalty10));\n  }\n\n  document.addEventListener('DOMContentLoaded', function () {\n    var form = el('rcForm');\n    form.addEventListener('input', update);\n    form.addEventListener('change', update);\n    form.addEventListener('submit', function (e) { e.preventDefault(); });\n    update();\n  });\n})();",

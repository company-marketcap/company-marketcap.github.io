  "meta_title": "RMD Current Year Calculator: 2026 RMD by Account",
  "meta_description": "Work out this year's required minimum distribution across your IRAs, 401(k)s and 403(b)s, which ones can be combined, the deadline and the penalty if missed.",
  "h1": "Required Minimum Distribution (RMD) Current Year Calculator",
  "subtitle": "Work out this year's RMD for each of your traditional IRAs and workplace plans, which ones you can combine into one withdrawal, when it is due, and the excise tax if you fall short.",
  "card": {
    "layout": "raw",
    "fields_html": "<section class=\"panel p-4 sm:p-6\" aria-labelledby=\"rcFormHeading\" data-section=\"calculator\">\n  <form id=\"rcForm\" class=\"space-y-5\" novalidate aria-labelledby=\"rcFormHeading\">\n    <h2 id=\"rcFormHeading\" class=\"panel-heading\">Enter your details and accounts</h2>\n    <div class=\"form-row form-row-2\">\n      <div><label for=\"rcBirth\" class=\"form-label\">Your year of birth</label><div class=\"input-group\"><input type=\"number\" id=\"rcBirth\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"1920\" max=\"2010\" step=\"1\" value=\"1952\" inputmode=\"numeric\"></div></div>\n      <div><label for=\"rcYear\" class=\"form-label\">RMD year</label><div class=\"input-group\"><input type=\"number\" id=\"rcYear\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"2024\" max=\"2040\" step=\"1\" value=\"2026\" inputmode=\"numeric\"></div><p class=\"form-hint\">The calendar year the withdrawal is for.</p></div>\n    </div>\n    <div class=\"space-y-3\">\n      <label class=\"form-choice\"><input type=\"checkbox\" id=\"rcSpouse\" class=\"form-choice-input\"><span class=\"form-choice-text\">My spouse is the sole beneficiary of these accounts for the whole year</span></label>\n      <div id=\"rcSpouseField\" class=\"form-field-hidden\"><label for=\"rcSpouseBirth\" class=\"form-label\">Spouse's year of birth</label><div class=\"input-group\"><input type=\"number\" id=\"rcSpouseBirth\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"1920\" max=\"2010\" step=\"1\" value=\"1964\" inputmode=\"numeric\"></div><p class=\"form-hint\">A spouse more than 10 years younger lets you use the Joint and Last Survivor table, which lowers the RMD.</p></div>\n    </div>\n    <div>\n      <p id=\"rcAccountsLabel\" class=\"form-label\">Your tax-deferred accounts</p>\n      <p class=\"form-hint\">Use each account's value on December 31 of the year before the RMD year. Leave a balance at 0 to skip a row. Roth IRAs and Roth 401(k) or 403(b) money have no RMDs while you are alive, so leave them out.</p>\n      <div class=\"table-scroll mt-3\" tabindex=\"0\" role=\"region\" aria-labelledby=\"rcAccountsLabel\">\n        <table class=\"data-table\">\n          <thead><tr><th scope=\"col\">Account</th><th scope=\"col\">Type</th><th scope=\"col\">Balance last Dec 31</th><th scope=\"col\">Already withdrawn this year</th><th scope=\"col\">Work status with this employer</th></tr></thead>\n          <tbody>\n<tr><th scope=\"row\">Account 1</th><td><select id=\"rcType1\" class=\"form-select\" aria-label=\"Account 1 type\"><option value=\"ira\" selected>Traditional, SEP or SIMPLE IRA</option><option value=\"403b\">403(b)</option><option value=\"401k\">401(k)</option><option value=\"457b\">Governmental 457(b)</option><option value=\"plan\">Other employer plan</option></select></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcBal1\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"1000\" value=\"250000\" inputmode=\"decimal\" aria-label=\"Account 1 balance on December 31 of last year\"></div></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcTaken1\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"100\" value=\"5000\" inputmode=\"decimal\" aria-label=\"Account 1 amount already withdrawn this year\"></div></td><td><select id=\"rcWork1\" class=\"form-select\" aria-label=\"Account 1 work status with the employer\"><option value=\"none\" selected>Left before this year</option><option value=\"retired\">Leaving or left this year</option><option value=\"working\">Still working there all year</option></select></td></tr>\n<tr><th scope=\"row\">Account 2</th><td><select id=\"rcType2\" class=\"form-select\" aria-label=\"Account 2 type\"><option value=\"ira\" selected>Traditional, SEP or SIMPLE IRA</option><option value=\"403b\">403(b)</option><option value=\"401k\">401(k)</option><option value=\"457b\">Governmental 457(b)</option><option value=\"plan\">Other employer plan</option></select></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcBal2\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"1000\" value=\"60000\" inputmode=\"decimal\" aria-label=\"Account 2 balance on December 31 of last year\"></div></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcTaken2\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"100\" value=\"0\" inputmode=\"decimal\" aria-label=\"Account 2 amount already withdrawn this year\"></div></td><td><select id=\"rcWork2\" class=\"form-select\" aria-label=\"Account 2 work status with the employer\"><option value=\"none\" selected>Left before this year</option><option value=\"retired\">Leaving or left this year</option><option value=\"working\">Still working there all year</option></select></td></tr>\n<tr><th scope=\"row\">Account 3</th><td><select id=\"rcType3\" class=\"form-select\" aria-label=\"Account 3 type\"><option value=\"ira\">Traditional, SEP or SIMPLE IRA</option><option value=\"403b\">403(b)</option><option value=\"401k\" selected>401(k)</option><option value=\"457b\">Governmental 457(b)</option><option value=\"plan\">Other employer plan</option></select></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcBal3\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"1000\" value=\"150000\" inputmode=\"decimal\" aria-label=\"Account 3 balance on December 31 of last year\"></div></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcTaken3\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"100\" value=\"0\" inputmode=\"decimal\" aria-label=\"Account 3 amount already withdrawn this year\"></div></td><td><select id=\"rcWork3\" class=\"form-select\" aria-label=\"Account 3 work status with the employer\"><option value=\"none\" selected>Left before this year</option><option value=\"retired\">Leaving or left this year</option><option value=\"working\">Still working there all year</option></select></td></tr>\n<tr><th scope=\"row\">Account 4</th><td><select id=\"rcType4\" class=\"form-select\" aria-label=\"Account 4 type\"><option value=\"ira\">Traditional, SEP or SIMPLE IRA</option><option value=\"403b\" selected>403(b)</option><option value=\"401k\">401(k)</option><option value=\"457b\">Governmental 457(b)</option><option value=\"plan\">Other employer plan</option></select></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcBal4\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"1000\" value=\"40000\" inputmode=\"decimal\" aria-label=\"Account 4 balance on December 31 of last year\"></div></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcTaken4\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"100\" value=\"0\" inputmode=\"decimal\" aria-label=\"Account 4 amount already withdrawn this year\"></div></td><td><select id=\"rcWork4\" class=\"form-select\" aria-label=\"Account 4 work status with the employer\"><option value=\"none\" selected>Left before this year</option><option value=\"retired\">Leaving or left this year</option><option value=\"working\">Still working there all year</option></select></td></tr>\n<tr><th scope=\"row\">Account 5</th><td><select id=\"rcType5\" class=\"form-select\" aria-label=\"Account 5 type\"><option value=\"ira\">Traditional, SEP or SIMPLE IRA</option><option value=\"403b\" selected>403(b)</option><option value=\"401k\">401(k)</option><option value=\"457b\">Governmental 457(b)</option><option value=\"plan\">Other employer plan</option></select></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcBal5\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"1000\" value=\"25000\" inputmode=\"decimal\" aria-label=\"Account 5 balance on December 31 of last year\"></div></td><td><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rcTaken5\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"100\" value=\"0\" inputmode=\"decimal\" aria-label=\"Account 5 amount already withdrawn this year\"></div></td><td><select id=\"rcWork5\" class=\"form-select\" aria-label=\"Account 5 work status with the employer\"><option value=\"none\" selected>Left before this year</option><option value=\"retired\">Leaving or left this year</option><option value=\"working\">Still working there all year</option></select></td></tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"form-hint\">The still-working exception applies only to the plan of the employer you still work for, only if the plan allows it, and never to someone who owns more than 5% of that employer. It never applies to IRAs.</p>\n    </div>\n    <p id=\"rcError\" class=\"form-error\" role=\"alert\" hidden></p>\n  </form>\n</section>\n<section class=\"panel @container p-4 sm:p-6\" aria-labelledby=\"rcResultsHeading\" data-section=\"results\">\n  <div id=\"rcResults\" aria-live=\"polite\">\n    <h2 id=\"rcResultsHeading\" class=\"panel-heading\">Your RMD for this year</h2>\n    <div class=\"stat-grid mt-4\">\n      <div class=\"stat-card stat-card-highlight\"><p class=\"stat-label\" id=\"rcTotalLabel\">Total RMD</p><p id=\"rcTotal\" class=\"stat-value\">–</p></div>\n      <div class=\"stat-card\"><p class=\"stat-label\">Still to withdraw</p><p id=\"rcRemaining\" class=\"stat-value\">–</p></div>\n      <div class=\"stat-card\"><p class=\"stat-label\">Deadline</p><p id=\"rcDeadline\" class=\"stat-value\">–</p></div>\n      <div class=\"stat-card\"><p class=\"stat-label\">Age at year-end</p><p id=\"rcAge\" class=\"stat-value\">–</p></div>\n      <div class=\"stat-card\"><p class=\"stat-label\" id=\"rcDivisorLabel\">Distribution period</p><p id=\"rcDivisor\" class=\"stat-value\">–</p></div>\n      <div class=\"stat-card\"><p class=\"stat-label\">First RMD year (age)</p><p id=\"rcFirst\" class=\"stat-value\">–</p></div>\n    </div>\n    <p id=\"rcNote\" class=\"mt-4 text-sm text-ink-muted\"></p>\n  </div>\n  <h3 id=\"rcGroupsHeading\" class=\"panel-heading mt-8\">Where each withdrawal can come from</h3>\n  <p class=\"mt-0.5 text-sm text-ink-muted\">IRA RMDs can be added together and taken from any of your IRAs, and 403(b) RMDs from any of your 403(b)s. A 401(k), 457(b) or other plan must pay out its own RMD. A withdrawal from one kind of account never counts toward another kind.</p>\n  <div class=\"table-scroll mt-4\" tabindex=\"0\" role=\"region\" aria-labelledby=\"rcGroupsHeading\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Group</th><th scope=\"col\">RMD</th><th scope=\"col\">Withdrawn</th><th scope=\"col\">Still to take</th><th scope=\"col\">Take it from</th><th scope=\"col\">Deadline</th></tr></thead>\n      <tbody id=\"rcGroups\"></tbody>\n    </table>\n  </div>\n  <h3 id=\"rcAccountsHeading\" class=\"panel-heading mt-8\">RMD by account</h3>\n  <div class=\"table-scroll mt-4\" tabindex=\"0\" role=\"region\" aria-labelledby=\"rcAccountsHeading\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Account</th><th scope=\"col\">Type</th><th scope=\"col\">Balance last Dec 31</th><th scope=\"col\">Divisor</th><th scope=\"col\">RMD</th><th scope=\"col\">Status</th></tr></thead>\n      <tbody id=\"rcAccounts\"></tbody>\n    </table>\n  </div>\n  <h3 class=\"panel-heading mt-8\">If you miss it</h3>\n  <div class=\"mt-4\">\n    <div class=\"result-row\"><span class=\"result-term\">Shortfall if nothing more is withdrawn</span><span id=\"rcShortfall\" class=\"result-value\">–</span></div>\n    <div class=\"result-row\"><span class=\"result-term\">Excise tax at 25%</span><span id=\"rcPenalty25\" class=\"result-value\">–</span></div>\n    <div class=\"result-row\"><span class=\"result-term\">Excise tax at 10% if corrected in time</span><span id=\"rcPenalty10\" class=\"result-value\">–</span></div>\n  </div>\n  <p class=\"callout mt-4\">The excise tax is 25% of the RMD you didn't take. It drops to 10% if you withdraw the missed amount and report the tax on Form 5329 within the correction window, which generally ends after two years. You can also ask the IRS to waive it for reasonable error if you fix the shortfall.</p>\n</section>",
    "extra_scripts": []
  },
  "script": "(function () {\n  'use strict';\n  // RMD for one year across several accounts. Each account's RMD = its December 31 balance of the\n  // prior year / the applicable denominator for the owner's age at year-end:\n  //   Uniform Lifetime Table (Table III), or the Joint and Last Survivor Table (Table II) when the\n  //   spouse is the sole beneficiary and more than 10 years younger (ages at birthdays in the year).\n  // Grouping (IRS RMD FAQ Q5): IRA RMDs are figured per IRA but may be taken in total from any IRA;\n  //   403(b) RMDs likewise among 403(b)s; 401(k), 457(b) and other plans each pay out their own RMD.\n  // Employer plans: required beginning date is April 1 after the later of the start-age year or the\n  //   year you retire from that employer (plan permitting, not for 5% owners) - Pub. 575.\n  // First RMD year: may be delayed to April 1 of the next year; later years are due December 31.\n  // Missed RMD: 25% excise tax, 10% if corrected within the correction window (IRC 4974; Pub. 575,\n  //   IRS RMD FAQ Q8).\n  // CHECKS (Node, scratch tests): born 1951, 2026 (age 75), IRA $100,000 / 24.6 = $4,065.04 and,\n  //   with sole-beneficiary spouse born 1962 (64), $100,000 / 25.3 = $3,952.57 (both Pub. 590-B\n  //   worked examples, which round to $4,065 and $3,953); $38,400 at 73 / 26.5 = $1,449.06 (Pub.\n  //   590-B Justin example, $1,450); defaults (born 1952, 2026, age 74, 25.5): IRAs $250,000 +\n  //   $60,000 -> $12,156.86 combined, 401(k) $150,000 -> $5,882.35, 403(b)s $40,000 + $25,000 ->\n  //   $2,549.02 combined; total $20,588.24; still-working 401(k) -> $0; born 1953 in 2026 = first\n  //   year (April 1, 2027); born 1960 -> start age 75; shortfall $1,000 -> $250 / $100.\n  //   Every Table II row used was parsed from Pub. 590-B (2025) Appendix B and checked symmetric\n  //   (row/column) for all 5,611 printed cells; 75/64 = 25.3 matches the Pub. 590-B example.\n  // ---- IRS RMD rules and tables (for distribution years 2022 and later; tax year 2026) -----------\n  // Uniform Lifetime Table: IRS Pub. 590-B (2025), Appendix B, Table III (Treas. Reg. 1.401(a)(9)-9).\n  var UNIFORM_TABLE = {\n    72: 27.4, 73: 26.5, 74: 25.5, 75: 24.6, 76: 23.7, 77: 22.9, 78: 22.0, 79: 21.1, 80: 20.2,\n    81: 19.4, 82: 18.5, 83: 17.7, 84: 16.8, 85: 16.0, 86: 15.2, 87: 14.4, 88: 13.7, 89: 12.9,\n    90: 12.2, 91: 11.5, 92: 10.8, 93: 10.1, 94: 9.5, 95: 8.9, 96: 8.4, 97: 7.8, 98: 7.3,\n    99: 6.8, 100: 6.4, 101: 6.0, 102: 5.6, 103: 5.2, 104: 4.9, 105: 4.6, 106: 4.3, 107: 4.1,\n    108: 3.9, 109: 3.7, 110: 3.5, 111: 3.4, 112: 3.3, 113: 3.1, 114: 3.0, 115: 2.9, 116: 2.8,\n    117: 2.7, 118: 2.5, 119: 2.3, 120: 2.0\n  };\n  // Joint and Last Survivor Table: IRS Pub. 590-B (2025), Appendix B, Table II. Only the cells an\n  // owner can use are kept: owner age 73 to 120 (120 = \"120+\"), spouse age 20 up to owner age - 11.\n  // Each string lists the factors x 10 for spouse ages 20, 21, 22, ...\n  var JOINT_TABLE_RAW = {\n    73: '651,642,632,622,612,603,593,584,574,564,555,545,536,526,517,507,498,488,479,469,460,451,441,432,423,414,404,395,386,377,368,360,351,342,334,326,317,309,301,294,286,279,272',\n    74: '651,641,632,622,612,603,593,583,574,564,555,545,536,526,517,507,498,488,479,469,460,450,441,432,422,413,404,395,386,377,368,359,350,341,333,324,316,308,300,292,284,277,270,262',\n    75: '651,641,632,622,612,603,593,583,574,564,555,545,535,526,516,507,497,488,478,469,459,450,441,431,422,413,403,394,385,376,367,358,349,341,332,324,315,307,299,291,283,275,268,261,253',\n    76: '651,641,632,622,612,602,593,583,574,564,554,545,535,526,516,507,497,488,478,469,459,450,440,431,422,412,403,394,385,375,366,357,349,340,331,323,314,306,298,290,282,274,266,259,252,244',\n    77: '651,641,631,622,612,602,593,583,573,564,554,545,535,526,516,507,497,488,478,469,459,450,440,431,421,412,403,393,384,375,366,357,348,339,330,322,313,305,297,288,280,273,265,257,250,243,235',\n    78: '651,641,631,622,612,602,593,583,573,564,554,545
0,38,36,34,33,32,31,30',\n    116: '650,641,631,621,611,602,592,582,573,563,553,544,534,525,515,505,496,486,477,467,457,448,438,429,419,410,400,390,381,371,362,353,343,334,325,316,307,298,289,280,271,263,254,246,237,229,221,213,204,196,188,180,172,164,156,149,141,134,127,120,113,106,100,94,88,83,77,73,68,64,60,56,52,49,46,44,41,39,37,35,33,32,31,30,29,28',\n    117: '650,641,631,621,611,602,592,582,573,563,553,544,534,525,515,505,496,486,477,467,457,448,438,429,419,410,400,390,381,371,362,353,343,334,325,316,307,298,289,280,271,263,254,246,237,229,221,212,204,196,188,180,172,164,156,149,141,134,127,120,113,106,100,94,88,82,77,72,68,63,59,55,52,49,46,43,40,38,36,34,33,31,30,29,28,27,27',\n    118: '650,641,631,621,611,602,592,582,573,563,553,544,534,525,515,505,496,486,477,467,457,448,438,429,419,410,400,390,381,371,362,353,343,334,325,316,307,298,289,280,271,263,254,245,237,229,221,212,204,196,188,180,172,164,156,149,141,134,126,119,113,106,100,93,88,82,77,72,67,63,58,55,51,48,45,42,39,37,35,33,31,30,28,27,26,26,25,25',\n    119: '650,641,631,621,611,602,592,582,573,563,553,544,534,525,515,505,496,486,477,467,457,448,438,429,419,410,400,390,381,371,362,353,343,334,325,316,307,298,289,280,271,262,254,245,237,229,221,212,204,196,188,180,172,164,156,148,141,134,126,119,112,106,99,93,87,82,76,71,66,62,58,54,50,47,44,41,38,36,33,31,29,28,26,25,24,24,23,23,23',\n    120: '650,641,631,621,611,602,592,582,573,563,553,544,534,525,515,505,496,486,477,467,457,448,438,429,419,410,400,390,381,371,362,353,343,334,325,316,306,298,289,280,271,262,254,245,237,229,220,212,204,196,188,180,172,164,156,148,141,133,126,119,112,105,99,93,87,81,76,71,66,61,57,53,49,46,43,40,37,34,32,30,28,26,25,23,22,21,21,21,20,20'\n  };\n  // RMD start age (SECURE 2.0 Act): born 1950 or earlier: 72; born 1951-1959: 73; born 1960 or\n  // later: 75. First RMD may wait until April 1 of the next year (Pub. 590-B).\n  // ------------------------------------------------------------------------------------------------\n  var SCENARIOS = ['Low', 'Middle', 'High'];\n\n  var jointCache = {};\n  function jointFactor(ownerAge, spouseAge) {\n    var o = Math.min(ownerAge, 120);\n    if (!jointCache[o]) {\n      var raw = JOINT_TABLE_RAW[o];\n      if (!raw) return null;\n      jointCache[o] = raw.split(',').map(function (x) { return parseInt(x, 10) / 10; });\n    }\n    var v = jointCache[o][spouseAge - 20];\n    return v === undefined ? null : v;\n  }\n  function uniformFactor(age) { return UNIFORM_TABLE[Math.min(age, 120)] || null; }\n  function startAge(birthYear) {\n    if (birthYear <= 1950) return 72;\n    if (birthYear <= 1959) return 73;\n    return 75;\n  }\n  function divisorFor(age, spouseAge) {\n    if (spouseAge !== null && age - spouseAge > 10 && spouseAge >= 20) {\n      var j = jointFactor(age, spouseAge);\n      if (j) return { factor: j, joint: true };\n    }\n    return { factor: uniformFactor(age), joint: false };\n  }\n\n  // p: { birth, year, balance, rate, tax, endAge, spouseBirth|null, delay }\n  function project(p) {\n    var sa = startAge(p.birth), first = p.birth + sa, b = p.balance, carry = 0, rows = [];\n    var totals = { rmd: 0, withdrawn: 0, tax: 0, firstRmd: null, firstYear: null, maxRmd: 0, maxYear: null };\n    for (var y = p.year; y - p.birth <= p.endAge; y++) {\n      var age = y - p.birth, spouseAge = p.spouseBirth === null ? null : y - p.spouseBirth;\n      var d = age >= sa ? divisorFor(age, spouseAge) : null;\n      var rmd = d ? Math.min(b, b / d.factor) : 0;\n      var grown = Math.max(0, b * (1 + p.rate));\n      var out;\n      if (p.delay && y === first) { out = 0; carry = rmd; }\n      else { out = rmd + carry; carry = 0; }\n      out = Math.min(out, grown);\n      var end = grown - out;\n      var tax = out * p.tax;\n      rows.push({ year: y, age: age, start: b, divisor: d, rmd: rmd, withdrawn: out, tax: tax, end: end });\n      totals.rmd += rmd; totals.withdrawn += out; totals.tax += tax;\n      if (rmd > 0 && totals.firstRmd === null) { totals.firstRmd = rmd; totals.firstYear = y; }\n      if (rmd > totals.maxRmd) { totals.maxRmd = rmd; totals.maxYear = y; }\n      b = end;\n    }\n    // A delayed first RMD falling after the last projected year is still owed.\n    totals.end = b;\n    totals.first = first;\n    totals.startAge = sa;\n    return { rows: rows, totals: totals };\n  }\n\n  var moneyFmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  var wholeFmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });\n  function money(x) { return moneyFmt.format(Math.abs(x) < 0.005 ? 0 : x); }\n  function whole(x) { return wholeFmt.format(Math.abs(x) < 0.5 ? 0 : x); }\n  function el(id) { return document.getElementById(id); }\n  function num(id) {\n    var raw = el(id).value;\n    if (raw === '' || raw === null || raw === undefined) return NaN;\n    var v = parseFloat(raw);\n    return isNaN(v) ? NaN : v;\n  }\n  function set(id, text) { el(id).textContent = text; }\n  function fillRows(id, rows) {\n    var body = el(id);\n    body.textContent = '';\n    rows.forEach(function (cells) {\n      var tr = document.createElement('tr');\n      cells.forEach(function (v) { var td = document.createElement('td'); td.textContent = v; tr.appendChild(td); });\n      body.appendChild(tr);\n    });\n  }\n\n  var last = null;\n  function renderSchedule() {\n    if (!last) { fillRows('rfSchedule', []); return; }\n    var idx = parseInt(el('rfShow').value, 10);\n    var res = last[idx] || last[1];\n    fillRows('rfSchedule', res.rows.map(function (r) {\n      return [String(r.year), String(r.age), money(r.start),\n              r.divisor ? r.divisor.factor.toFixed(1) + (r.divisor.joint ? ' (joint)' : '') : '–',\n              money(r.rmd), money(r.withdrawn), money(r.tax), money(r.withdrawn - r.tax), money(r.end)];\n    }));\n  }\n\n  function update() {\n    var spouseOn = el('rfSpouse').checked;\n    el('rfSpouseField').classList.toggle('form-field-hidden', !spouseOn);\n    var birth = Math.round(num('rfBirth')), year = Math.round(num('rfYear')), balance = num('rfBalance'),\n        rates = [num('rfLow'), num('rfBase'), num('rfHigh')], tax = num('rfTax'), endAge = Math.round(num('rfEndAge')),\n        spouseBirth = spouseOn ? Math.round(num('rfSpouseBirth')) : null;\n    var error = el('rfError'), msg = '';\n    if ([birth, year, balance, tax, endAge].some(isNaN) || rates.some(isNaN)) {\n      msg = 'Fill in every field with a number.';\n    } else if (birth < 1920 || birth > 2010 || year < 2024 || year > 2040 || year - birth > 120) {\n      msg = 'Enter a birth year from 1920 to 2010 and a first projection year from 2024 to 2040 (age 120 or under).';\n    } else if (balance < 0 || tax < 0 || tax > 70 || rates.some(function (r) { return r < -50 || r > 30; })) {\n      msg = 'Use a balance of 0 or more, returns from -50% to 30% and a tax rate from 0% to 70%.';\n    } else if (endAge < 60 || endAge > 120 || endAge < year - birth) {\n      msg = 'Project to an age from 60 to 120 that is not below your age in the first projected year (' + (year - birth) + ').';\n    } else if (spouseOn && (isNaN(spouseBirth) || spouseBirth < 1920 || spouseBirth > 2010)) {\n      msg = 'Enter your spouse’s year of birth from 1920 to 2010.';\n    } else if (spouseOn && spouseBirth - birth > 10 && year - spouseBirth < 20) {\n      msg = 'The IRS joint life table starts at age 20. Your spouse must be at least 20 in the first projected year.';\n    }\n    error.hidden = !msg;\n    if (msg) {\n      error.textContent = msg;\n      last = null;\n      ['rfFirst', 'rfTotal', 'rfTaxTotal', 'rfEnd'].forEach(function (id) { set(id, '–'); });\n      set('rfNote', '');\n      fillRows('rfScenarios', []);\n      renderSchedule();\n      return;\n    }\n    var base = { birth: birth, year: year, balance: balance, tax: tax / 100, endAge: endAge,\n                 spouseBirth: spouseBirth, delay: el('rfDelay').checked };\n    last = rates.map(function (r) {\n      var o = {}; for (var k in base) o[k] = base[k]; o.rate = r / 100; return project(o);\n    });\n    var mid = last[1].totals;\n    set('rfFirstLabel', mid.firstYear !== null ? 'First RMD (' + mid.firstYear + ')' : 'First RMD');\n    set('rfFirst', mid.firstRmd !== null ? money(mid.firstRmd) : 'None');\n    set('rfTotalLabel', 'Total RMDs to age ' + endAge);\n    set('rfTotal', money(mid.rmd));\n    set('rfTaxTotal', money(mid.tax));\n    set('rfEndLabel', 'Balance left at ' + endAge);\n    set('rfEnd', money(mid.end));\n\n    var notes = [];\n    if (birth + mid.startAge >= year) {\n      notes.push('Your RMDs start with ' + mid.first + ', the year you turn ' + mid.startAge + '.');\n    } else {\n      notes.push('You are already taking RMDs (they started with ' + (birth <= 1949 ? 'age 70½' : mid.first) + ').');\n    }\n    if (spouseOn) {\n      if (spouseBirth - birth > 10) notes.push('Your spouse is more than 10 years younger, so every year uses the Joint and Last Survivor table, which keeps RMDs lower.');\n      else notes.push('Your spouse is not more than 10 years younger, so the Uniform Lifetime Table applies.');\n    }\n    if (base.delay && mid.first >= year) {\n      notes.push('With the first RMD delayed to April 1, ' + (mid.first + 1) + ', two RMDs are withdrawn and taxed in ' + (mid.first + 1) + '.');\n    }\n    if (mid.withdrawn < mid.rmd - 0.005) {\n      notes.push('A delayed first RMD falls after the last projected year, so it is not counted as withdrawn.');\n    }\n    set('rfNote', notes.join(' '));\n\n    fillRows('rfScenarios', last.map(function (res, i) {\n      var t = res.totals;\n      return [SCENARIOS[i] + ' (' + rates[i] + '%)', t.firstRmd !== null ? whole(t.firstRmd) : '–',\n              t.maxYear !== null ? whole(t.maxRmd) + ' (' + t.maxYear + ')' : '–',\n              whole(t.rmd), whole(t.withdrawn - t.tax), whole(t.end)];\n    }));\n    renderSchedule();\n  }\n\n  document.addEventListener('DOMContentLoaded', function () {\n    var form = el('rfForm');\n    form.addEventListener('input', update);\n    form.addEventListener('change', update);\n    form.addEventListener('submit', function (e) { e.preventDefault(); });\n    el('rfShow').addEventListener('change', renderSchedule);\n    update();\n  });\n})();",

  "meta_title": "RMD Projection Calculator: Future RMDs and Taxes",
  "meta_description": "Project your required minimum distributions, taxes and balance year by year under low, middle and high returns, including the younger-spouse joint table.",
  "h1": "Required Minimum Distribution (RMD) Future Projection Calculator",
  "subtitle": "Project your RMDs, the tax on them and your remaining balance year by year under three return scenarios, using the joint life table when your spouse is more than 10 years younger.",
  "card": {
    "layout": "raw",
    "fields_html": "<section class=\"panel @container p-4 sm:p-6\" aria-labelledby=\"rfFormHeading\" data-section=\"calculator\">\n  <div class=\"grid gap-8 @3xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]\">\n    <form id=\"rfForm\" class=\"space-y-5\" novalidate aria-labelledby=\"rfFormHeading\">\n      <h2 id=\"rfFormHeading\" class=\"panel-heading\">Enter your account and assumptions</h2>\n      <div class=\"form-row form-row-2\">\n        <div><label for=\"rfBirth\" class=\"form-label\">Your year of birth</label><div class=\"input-group\"><input type=\"number\" id=\"rfBirth\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"1920\" max=\"2010\" step=\"1\" value=\"1958\" inputmode=\"numeric\"></div></div>\n        <div><label for=\"rfYear\" class=\"form-label\">First year to project</label><div class=\"input-group\"><input type=\"number\" id=\"rfYear\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"2024\" max=\"2040\" step=\"1\" value=\"2026\" inputmode=\"numeric\"></div></div>\n      </div>\n      <div><label for=\"rfBalance\" class=\"form-label\">Balance on December 31 of the year before</label><div class=\"input-group\"><span class=\"input-affix\">$</span><input type=\"number\" id=\"rfBalance\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" step=\"1000\" value=\"500000\" inputmode=\"decimal\"></div><p class=\"form-hint\">Combine all traditional IRAs and plans that use the same life expectancy table. Roth IRAs have no lifetime RMDs.</p></div>\n      <fieldset>\n        <legend class=\"form-label\">Annual return scenarios</legend>\n        <div class=\"form-row form-row-3\">\n          <div><label for=\"rfLow\" class=\"form-hint\">Low</label><div class=\"input-group\"><input type=\"number\" id=\"rfLow\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"-50\" max=\"30\" step=\"0.1\" value=\"3\" inputmode=\"decimal\"><span class=\"input-affix\">%</span></div></div>\n          <div><label for=\"rfBase\" class=\"form-hint\">Middle</label><div class=\"input-group\"><input type=\"number\" id=\"rfBase\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"-50\" max=\"30\" step=\"0.1\" value=\"5\" inputmode=\"decimal\"><span class=\"input-affix\">%</span></div></div>\n          <div><label for=\"rfHigh\" class=\"form-hint\">High</label><div class=\"input-group\"><input type=\"number\" id=\"rfHigh\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"-50\" max=\"30\" step=\"0.1\" value=\"7\" inputmode=\"decimal\"><span class=\"input-affix\">%</span></div></div>\n        </div>\n      </fieldset>\n      <div class=\"form-row form-row-2\">\n        <div><label for=\"rfTax\" class=\"form-label\">Tax rate on withdrawals</label><div class=\"input-group\"><input type=\"number\" id=\"rfTax\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" max=\"70\" step=\"0.5\" value=\"24\" inputmode=\"decimal\"><span class=\"input-affix\">%</span></div><p class=\"form-hint\">Your federal plus state rate.</p></div>\n        <div><label for=\"rfEndAge\" class=\"form-label\">Project to age</label><div class=\"input-group\"><input type=\"number\" id=\"rfEndAge\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"60\" max=\"120\" step=\"1\" value=\"95\" inputmode=\"numeric\"></div></div>\n      </div>\n      <div class=\"space-y-3\">\n        <label class=\"form-choice\"><input type=\"checkbox\" id=\"rfSpouse\" class=\"form-choice-input\"><span class=\"form-choice-text\">My spouse is my sole beneficiary</span></label>\n        <div id=\"rfSpouseField\" class=\"form-field-hidden\"><label for=\"rfSpouseBirth\" class=\"form-label\">Spouse's year of birth</label><div class=\"input-group\"><input type=\"number\" id=\"rfSpouseBirth\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"1920\" max=\"2010\" step=\"1\" value=\"1970\" inputmode=\"numeric\"></div><p class=\"form-hint\">If your spouse is more than 10 years younger, each year uses the Joint and Last Survivor table.</p></div>\n      </div>\n      <details class=\"form-details\"><summary class=\"form-details-summary\">More options</summary>\n        <label class=\"form-choice\"><input type=\"checkbox\" id=\"rfDelay\" class=\"form-choice-input\"><span class=\"form-choice-text\">Delay my first RMD to April 1 of the following year</span></label>\n        <p class=\"form-hint\">Delaying puts two RMDs in the second year's taxable income.</p>\n      </details>\n      <p id=\"rfError\" class=\"form-error\" role=\"alert\" hidden></p>\n    </form>\n    <div id=\"rfResults\" aria-live=\"polite\" aria-labelledby=\"rfResultsHeading\">\n      <h2 id=\"rfResultsHeading\" class=\"panel-heading\">Middle scenario</h2>\n      <div class=\"stat-grid mt-4\">\n        <div class=\"stat-card stat-card-highlight\"><p class=\"stat-label\" id=\"rfFirstLabel\">First RMD</p><p id=\"rfFirst\" class=\"stat-value\">–</p></div>\n        <div class=\"stat-card\"><p class=\"stat-label\" id=\"rfTotalLabel\">Total RMDs</p><p id=\"rfTotal\" class=\"stat-value\">–</p></div>\n        <div class=\"stat-card\"><p class=\"stat-label\">Tax on RMDs</p><p id=\"rfTaxTotal\" class=\"stat-value\">–</p></div>\n        <div class=\"stat-card\"><p class=\"stat-label\" id=\"rfEndLabel\">Balance left</p><p id=\"rfEnd\" class=\"stat-value\">–</p></div>\n      </div>\n      <p id=\"rfNote\" class=\"mt-4 text-sm text-ink-muted\"></p>\n      <h3 id=\"rfScenarioHeading\" class=\"panel-heading mt-6\">All three scenarios</h3>\n      <div class=\"table-scroll mt-3\" tabindex=\"0\" role=\"region\" aria-labelledby=\"rfScenarioHeading\">\n        <table class=\"data-table\">\n          <thead><tr><th scope=\"col\">Scenario</th><th scope=\"col\">First RMD</th><th scope=\"col\">Largest RMD</th><th scope=\"col\">Total RMDs</th><th scope=\"col\">After tax</th><th scope=\"col\">Balance left</th></tr></thead>\n          <tbody id=\"rfScenarios\"></tbody>\n        </table>\n      </div>\n      <p class=\"callout mt-4\">Assumes you withdraw only the RMD each year, at year-end, and that your spouse stays your sole beneficiary. Actual returns vary from year to year.</p>\n    </div>\n  </div>\n</section>\n<section class=\"panel p-4 sm:p-6\" aria-labelledby=\"rfScheduleHeading\" data-section=\"schedule\">\n  <h2 id=\"rfScheduleHeading\" class=\"panel-heading\">Year-by-year projection</h2>\n  <div class=\"mt-3 max-w-xs\"><label for=\"rfShow\" class=\"form-label\">Show scenario</label>\n    <select id=\"rfShow\" class=\"form-select\"><option value=\"0\">Low return</option><option value=\"1\" selected>Middle return</option><option value=\"2\">High return</option></select></div>\n  <div class=\"table-scroll mt-5 max-h-[520px]\" tabindex=\"0\" role=\"region\" aria-labelledby=\"rfScheduleHeading\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Age</th><th scope=\"col\">Balance Dec 31 prior year</th><th scope=\"col\">Divisor</th><th scope=\"col\">RMD for the year</th><th scope=\"col\">Withdrawn in the year</th><th scope=\"col\">Tax</th><th scope=\"col\">After tax</th><th scope=\"col\">Balance Dec 31</th></tr></thead>\n      <tbody id=\"rfSchedule\"></tbody>\n    </table>\n  </div>\n</section>",
    "extra_scripts": []
  },
  "script": "(function () {\n  'use strict';\n  // RMD projection under three return scenarios. Starting from the December 31 balance before the\n  // first projected year, each year:\n  //   RMD(year) = balance Dec 31 prior year / applicable denominator for the owner's age at year-end\n  //     (Uniform Lifetime Table III, or Joint and Last Survivor Table II for each year in which the\n  //     sole-beneficiary spouse is more than 10 years younger - ages at birthdays in that year);\n  //   balance Dec 31 = prior balance x (1 + return) - amount withdrawn in the year (taken at year-end).\n  //   With the April 1 option, the first year's RMD is withdrawn in the following year together with\n  //   that year's RMD; the following year's RMD is still figured on the full Dec 31 balance.\n  //   Tax = amount withdrawn in the year x the entered rate.\n  // CHECKS (Node, scratch tests): 0% return, born 1951, $100,000 at 75 (2026): RMD $4,065.04, then\n  //   $95,934.96 / 23.7 = $4,047.89 (hand calculation); born 1951, spouse born 1962, $100,000:\n  //   2026 RMD $100,000 / 25.3 = $3,952.57 (Pub. 590-B example), 2027 uses Table II 76/65 = 24.4 (Pub. 590-B Appendix B row 76, column 65);\n  //   defaults (born 1958, $500,000, 5%): balance before first RMD = 500,000 x 1.05^5 = $638,140.78,\n  //   first RMD (2031, age 73) = $638,140.78 / 26.5 = $24,080.78, tax at 24% = $5,779.39; the year\n  //   loop balances check: start x (1 + r) - withdrawn = end in every row; delay option: 2031\n  //   withdrawn $0, 2032 withdrawn = RMD 2031 + RMD 2032 figured on the undiminished balance.\n  //   Table II rows were parsed from Pub. 590-B (2025) Appendix B and checked symmetric.\n  // ---- IRS RMD rules and tables (for distribution years 2022 and later; tax year 2026) -----------\n  // Uniform Lifetime Table: IRS Pub. 590-B (2025), Appendix B, Table III (Treas. Reg. 1.401(a)(9)-9).\n  var UNIFORM_TABLE = {\n    72: 27.4, 73: 26.5, 74: 25.5, 75: 24.6, 76: 23.7, 77: 22.9, 78: 22.0, 79: 21.1, 8
  "meta_title": "Life Expectancy Calculator by Age and Sex (SSA Table)",
  "meta_description": "Estimate your remaining years, expected age and chance of reaching 80, 90 or 100, using the Social Security Administration's US period life table.",
  "h1": "Life Expectancy Calculator",
  "subtitle": "See how many more years an average American of your age and sex can expect to live, and the chance of reaching each later age, from official Social Security life tables.",
  "card": {
    "layout": "raw",
    "fields_html": "<section class=\"panel @container p-4 sm:p-6\" aria-labelledby=\"leFormHeading\" data-section=\"calculator\">\n  <div class=\"grid gap-8 @3xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]\">\n    <form id=\"leForm\" class=\"space-y-5\" novalidate aria-labelledby=\"leFormHeading\">\n      <h2 id=\"leFormHeading\" class=\"panel-heading\">Enter your age and sex</h2>\n      <div class=\"form-row form-row-2\">\n        <div><label for=\"leAge\" class=\"form-label\">Current age</label>\n          <div class=\"input-group\"><input type=\"number\" id=\"leAge\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"0\" max=\"119\" step=\"1\" value=\"65\" inputmode=\"numeric\"><span class=\"input-affix\">yrs</span></div></div>\n        <div><label for=\"leSex\" class=\"form-label\">Sex</label>\n          <select id=\"leSex\" class=\"form-select\"><option value=\"male\" selected>Male</option><option value=\"female\">Female</option></select></div>\n      </div>\n      <div><label for=\"leTarget\" class=\"form-label\">Chance of living to age</label>\n        <div class=\"input-group\"><input type=\"number\" id=\"leTarget\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[15px] tabular-nums text-ink focus:outline-none\" min=\"1\" max=\"120\" step=\"1\" value=\"90\" inputmode=\"numeric\"><span class=\"input-affix\">yrs</span></div>\n        <p class=\"form-hint\">Pick an age you might plan your retirement savings to last until.</p></div>\n      <p id=\"leError\" class=\"form-error\" role=\"alert\" hidden></p>\n      <div class=\"callout text-sm\"><p>Figures come from the Social Security Administration's period life table for <span id=\"leTableYear\">2023</span> (used in the <span id=\"leTableReport\">2026</span> Trustees Report). They are averages for the whole US population and do not reflect your own health, habits or family history.</p></div>\n    </form>\n    <div id=\"leResults\" aria-live=\"polite\" aria-labelledby=\"leResultsHeading\">\n      <h2 id=\"leResultsHeading\" class=\"panel-heading\">Your results</h2>\n      <div class=\"stat-grid mt-4\">\n        <div class=\"stat-card stat-card-highlight\"><p class=\"stat-label\">Remaining life expectancy</p><p id=\"leRemaining\" class=\"stat-value\">–</p></div>\n        <div class=\"stat-card\"><p class=\"stat-label\">Expected age at death</p><p id=\"leExpected\" class=\"stat-value\">–</p></div>\n        <div class=\"stat-card\"><p class=\"stat-label\" id=\"leTargetLabel\">Chance of reaching 90</p><p id=\"leTargetChance\" class=\"stat-value\">–</p></div>\n        <div class=\"stat-card\"><p class=\"stat-label\">Half of people your age live past</p><p id=\"leMedian\" class=\"stat-value\">–</p></div>\n      </div>\n      <div class=\"mt-5\">\n        <div class=\"result-row\"><span class=\"result-term\">1 in 4 chance of living to</span><span id=\"leP25\" class=\"result-value\">–</span></div>\n        <div class=\"result-row\"><span class=\"result-term\">1 in 10 chance of living to</span><span id=\"leP10\" class=\"result-value\">–</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n<section class=\"panel p-4 sm:p-6\" aria-labelledby=\"leTableHeading\" data-section=\"schedule\">\n  <h2 id=\"leTableHeading\" class=\"panel-heading\">Chance of reaching each age</h2>\n  <p class=\"mt-0.5 text-sm text-ink-muted\">Your chance of being alive at each age, starting from your current age, for both sexes.</p>\n  <div class=\"table-scroll mt-5 max-h-[520px]\" tabindex=\"0\" role=\"region\" aria-labelledby=\"leTableHeading\">\n    <table class=\"data-table\">\n      <thead><tr><th scope=\"col\">Age</th><th scope=\"col\">Years from now</th><th scope=\"col\" id=\"leColYou\">Male (you)</th><th scope=\"col\" id=\"leColOther\">Female</th></tr></thead>\n      <tbody id=\"leSchedule\"></tbody>\n    </table>\n  </div>\n</section>",
    "extra_scripts": []
  },
  "script": "(function () {\n  'use strict';\n  // Life expectancy from a published US period life table. For a person at exact age x:\n  //   remaining years = e(x) as published; expected age = x + e(x)\n  //   chance of reaching age T = product over a = x .. T-1 of (1 - q(a))\n  // The age half (a quarter, a tenth) of people your age outlive is where that survival curve\n  // crosses 50% (25%, 10%), interpolated linearly within the year.\n  // CHECKS (Node, scratch tests): the product of (1 - q) from birth reproduces the table's own\n  // \"number of lives\" column (male l(65) = 79,084, female l(65) = 87,399 per 100,000); male 65 -> 90\n  // = 0.2410 against l(90)/l(65) = 19,063/79,084; e(65) shows 18.12 (male) and 20.66 (female) as in\n  // the table; age 119 has a 0% chance of reaching 120 and no NaN at the table's ends.\n  // ---- Life table: SSA Office of the Chief Actuary, \"Actuarial Life Table\" -----------------------\n  // Period Life Table, 2023, as used in the 2026 Trustees Report (Social Security area population),\n  // https://www.ssa.gov/oact/STATS/table4c6.html. q = probability of dying within one year at\n  // each exact age 0-119; e = period life expectancy (years) at each exact age 0-119.\n  var TABLE = {\n    year: 2023,\n    report: 2026,\n    qMale: [.006015, .000479, .000320, .000249, .000194, .000159, .000137, .000125, .000120, .000120, .000125, .000140, .000173, .000233, .000327, .000463, .000634, .000819, .000999, .001138, .001235, .001315, .001378, .001439, .001509, .001595, .001685, .001783, .001876, .001970, .002085, .002202, .002308, .002407, .002490, .002577, .002665, .002764, .002864, .002987, .003115, .003253, .003419, .003600, .003777, .003931, .004073, .004245, .004477, .004795, .005126, .005496, .005917, .006404, .006923, .007491, .008173, .008938, .009714, .010494, .011337, .012232, .013196, .014229, .015316, .016455, .017574, .018735, .019981, .021366, .022903, .024615, .026504, .028648, .031071, .033802, .037010, .041158, .045461, .050346, .055633, .061757, .068358, .075420, .083364, .092680, .103459, .115502, .129018, .143810, .159458, .176551, .195360, .216286, .238799, .262268, .286291, .310944, .332325, .349036, .366568, .384960, .404252, .424488, .445712, .467998, .491398, .515968, .541766, .568854, .597297, .627162, .658520, .691446, .726018, .762319, .800435, .840457, .882480, .926604],\n    eMale: [75.79, 75.25, 74.28, 73.31, 72.33, 71.34, 70.35, 69.36, 68.37, 67.38, 66.39, 65.39, 64.40, 63.41, 62.43, 61.45, 60.48, 59.51, 58.56, 57.62, 56.69, 55.76, 54.83, 53.90, 52.98, 52.06, 51.14, 50.23, 49.32, 48.41, 47.50, 46.60, 45.70, 44.81, 43.91, 43.02, 42.13, 41.24, 40.36, 39.47, 38.59, 37.71, 36.83, 35.95, 35.08, 34.21, 33.34, 32.48, 31.62, 30.76, 29.90, 29.05, 28.21, 27.38, 26.55, 25.73, 24.92, 24.12, 23.34, 22.56, 21.79, 21.04, 20.29, 19.56, 18.83, 18.12, 17.41, 16.71, 16.02, 15.34, 14.66, 14.00, 13.34, 12.69, 12.05, 11.42, 10.80, 10.19, 9.61, 9.04, 8.50, 7.97, 7.46, 6.97, 6.50, 6.04, 5.61, 5.20, 4.81, 4.45, 4.11, 3.80, 3.50, 3.23, 2.99, 2.77, 2.58, 2.41, 2.27, 2.15, 2.04, 1.93, 1.83, 1.72, 1.63, 1.54, 1.45, 1.36, 1.28, 1.20, 1.13, 1.05, 0.98, 0.92, 0.85, 0.79, 0.74, 0.68, 0.63, 0.58],\n    qFemale: [.005125, .000392, .000229, .000188, .000155, .000133, .000115, .000105, .000100, .000098, .000101, .000111, .000126, .000152, .000188, .000229, .000273, .000323, .000372, .000410, .000441, .000476, .000513, .000546, .000582, .000609, .000641, .000683, .000740, .000808, .000878, .000947, .001018, .001089, .001154, .001209, .001263, .001347, .001438, .001533, .001643, .001742, .001845, .001954, .002075, .002187, .002306, .002438, .002595, .002791, .003030, .003288, .003554, .003847, .004172, .004532, .004923, .005365, .005815, .006333, .006923, .007555, .008220, .008881, .009514, .010188, .010880, .011659, .012543, .013581, .014769, .016153, .017705, .019495, .021533, .023846, .026458, .029700, .033135, .036982, .041183, .045959, .051282, .057262, .064107, .071752, .080490, .090566, .102204, .115178, .129176, .144229, .160353, .177635, .196502, .216846, .238750, .261359, .283899, .306491, .329680, .353333, .377300, .401416, .425501, .451031, .478092, .506778, .537185, .568854, .597297, .627162, .658520, .691446, .726018, .762319, .800435, .840457, .882480, .926604],\n    eFemale: [81.06, 80.48, 79.51, 78.53, 77.54, 76.55, 75.56, 74.57, 73.58, 72.59, 71.59, 70.60, 69.61, 68.62, 67.63, 66.64, 65.66, 64.67, 63.69, 62.72, 61.74, 60.77, 59.80, 58.83, 57.86, 56.90, 55.93, 54.97, 54.00, 53.04, 52.08, 51.13, 50.18, 49.23, 48.28, 47.34, 46.39, 45.45, 44.51, 43.58, 42.64, 41.71, 40.78, 39.86, 38.93, 38.01, 37.10, 36.18, 35.27, 34.36, 33.45, 32.55, 31.66, 30.77, 29.89, 29.01, 28.14, 27.28, 26.42, 25.57, 24.73, 23.90, 23.08, 22.27, 21.46, 20.66, 19.87, 19.08, 18.30, 17.53, 16.76, 16.01, 15.26, 14.53, 13.81, 13.10, 12.41, 11.73, 11.08, 10.44, 9.82, 9.22, 8.64, 8.08, 7.54, 7.02, 6.53, 6.05, 5.61, 5.19, 4.80, 4.44, 4.10, 3.79, 3.50, 3.23, 2.99, 2.77, 2.57, 2.39, 2.23, 2.08, 1.94, 1.82, 1.70, 1.59, 1.48, 1.38, 1.29, 1.20, 1.13, 1.05, 0.98, 0.92, 0.85, 0.79, 0.74, 0.68, 0.63, 0.58]\n  };\n  // ------------------------------------------------------------------------------------------------\n  var MAX_AGE = TABLE.qMale.length - 1; // 119\n  var pct = new Intl.NumberFormat('en-US', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 });\n  var one = new Intl.NumberFormat('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n\n  function num(id) {\n    var v = parseFloat(document.getElementById(id).value);\n    return isNaN(v) ? NaN : v;\n  }\n  function set(id, text) { document.getElementById(id).textContent = text; }\n\n  // Chance that someone at exact age x is alive at exact age t (t >= x).\n  function survival(q, x, t) {\n    var p = 1;\n    for (var a = x; a < t; a++) p *= a <= MAX_AGE ? 1 - q[a] : 0;\n    return p;\n  }\n\n  // Age at which the survival chance from age x falls to the given level.\n  function ageAtLevel(q, x, level) {\n    var prev = 1;\n    for (var a = x; a <= MAX_AGE; a++) {\n      var next = prev * (1 - q[a]);\n      if (next <= level) return a + (prev - level) / (prev - next);\n      prev = next;\n    }\n    return MAX_AGE + 1;\n  }\n\n  function update() {\n    var age = num('leAge'), target = num('leTarget'), sex = document.getElementById('leSex').value;\n    var error = document.getElementById('leError');\n    var bad = isNaN(age) || isNaN(target) || age < 0 || age > MAX_AGE || age !== Math.floor(age) ||\n              target !== Math.floor(target) || target <= age || target > MAX_AGE + 1;\n    error.hidden = !bad;\n    if (bad) {\n      error.textContent = 'Enter a whole-number age from 0 to ' + MAX_AGE + ' and a later target age up to ' + (MAX_AGE + 1) + '.';\n      return;\n    }\n    var q = sex === 'female' ? TABLE.qFemale : TABLE.qMale, e = sex === 'female' ? TABLE.eFemale : TABLE.eMale;\n    var other = sex === 'female' ? TABLE.qMale : TABLE.qFemale;\n    set('leRemaining', one.format(e[age]) + ' years');\n    set('leExpected', one.format(age + e[age]));\n    set('leTargetLabel', 'Chance of reaching ' + target);\n    set('leTargetChance', pct.format(survival(q, age, target)));\n    set('leMedian', 'Age ' + one.format(ageAtLevel(q, age, 0.5)));\n    set('leP25', 'Age ' + one.format(ageAtLevel(q, age, 0.25)));\n    set('leP10', 'Age ' + one.format(ageAtLevel(q, age, 0.10)));\n    set('leColYou', sex === 'female' ? 'Female (you)' : 'Male (you)');\n    set('leColOther', sex === 'female' ? 'Male' : 'Female');\n    var rows = [], start = Math.max(age + 1, Math.ceil((age + 1) / 5) * 5);\n    if (start > age + 1) rows.push(age + 1);\n    for (var t = start; t <= 110; t += 5) rows.push(t);\n    if (!rows.length) rows.push(age + 1);\n    document.getElementById('leSchedule').innerHTML = rows.map(function (t) {\n      return '<tr><td>' + t + '</td><td>' + (t - age) + '</td><td>' + pct.format(survival(q, age, t)) +\n             '</td><td>' + pct.format(survival(other, age, t)) + '</td></tr>';\n    }).join('');\n  }\n\n  document.addEventListener('DOMContentLoaded', function () {\n    set('leTableYear', String(TABLE.year));\n    set('leTableReport', String(TABLE.report));\n    var form = document.getElementById('leForm');\n    form.addEventListener('input', update);\n    form.addEventListener('change', update);\n    form.addEventListener('submit', function (e) { e.preventDefault(); });\n    update();\n  });\n})();",
